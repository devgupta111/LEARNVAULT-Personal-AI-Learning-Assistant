# -----------------------------------------------------------------------
# .gitignore — Personal AI Learning Assistant
# -----------------------------------------------------------------------

# Secrets & Environment Files — NEVER commit secrets
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Local Databases — NEVER commit local DB with student data
*.db
*.sqlite
*.sqlite3
*.db-journal
test_temp.db
data/*.db
data/*.sqlite*
data/*.db-journal
data/qdrant_local/
data/qdrant_local*

# Private Notes & Reference
project-reference/
Do not read/
Donotread*

# Uploaded documents & user files (keeps directory structure, tracks demo PDFs)
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/lec-1.pdf
!data/uploads/Lec-2.pdf
data/processed/*
!data/processed/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Tests & Coverage
.pytest_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/.env.local
frontend/.env*.local
frontend/AGENTS.md
frontend/CLAUDE.md

# Docker & Logs
*.log
docker-data/
postgres_data/

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

