# -----------------------------------------------------------------------
# .env.example — Personal AI Learning Assistant
#
# INSTRUCTIONS:
# 1. Copy this file to create your local '.env':
#      cp .env.example .env                  (Linux/macOS)
#      Copy-Item .env.example .env          (Windows PowerShell)
# 2. Update credentials below according to your local setup.
# 3. NEVER commit the '.env' file to Git — it is ignored by .gitignore
#    to protect passwords, API keys, and sensitive configuration.
# -----------------------------------------------------------------------

# Database URL
# For PostgreSQL (via Docker or local Windows service):
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>
# If PostgreSQL is unavailable, the app automatically falls back to local SQLite.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_learning_db

# Local storage path for uploaded PDF files
UPLOAD_DIR=data/uploads

# Maximum allowed PDF upload size in megabytes
MAX_FILE_SIZE_MB=20

# Qdrant Vector Database (Day 3)
# URL of the Qdrant service (default Docker port is 6333).
# If Docker is not running, the application automatically falls back to
# embedded disk storage at data/qdrant_local/ without needing Docker.
QDRANT_URL=http://localhost:6333

# Optional: Only required if using a secured remote/cloud Qdrant instance.
# Leave blank for local development / Docker.
QDRANT_API_KEY=

# Collection name for storing 384-dimensional document embeddings.
QDRANT_COLLECTION_NAME=learning_assistant

# -----------------------------------------------------------------------
# Day 4 — RAG LLM Generation & Retrieval Reranking
# -----------------------------------------------------------------------

# Groq API key for grounded RAG generation (server-side only).
# Get a free key at: https://console.groq.com
# This key is NEVER exposed to the frontend or browser.
RAG_API_KEY=

# Model for grounded RAG generation (hosted on Groq).
# Default: openai/gpt-oss-120b
RAG_MODEL=openai/gpt-oss-120b

# ── Cross-Encoder Reranker Settings (FlashRank) ───────────────────────
# Relevance threshold for the cross-encoder reranker.
# Evidence scoring below this value triggers the unified refusal message.
# Tune this based on your actual documents and query distribution.
RERANK_THRESHOLD=0.35

# Maximum number of unique parent context chunks sent to the LLM.
RERANK_TOP_K=4

# -----------------------------------------------------------------------
# Day 5 — Query Router/Rewriter & CRAG Agent Credentials
# -----------------------------------------------------------------------

# Dedicated Groq API key for Query Router & Rewriter (falls back to RAG_API_KEY if unset).
ROUTER_API_KEY=

# Model used by the Query Router & Rewriter Agent.
ROUTER_MODEL=llama-3.1-8b-instant

# Dedicated Groq API key for CRAG Agent (falls back to RAG_API_KEY if unset).
CRAG_API_KEY=

# Model used by the CRAG Agent for alternative query generation.
CRAG_MODEL=llama-3.1-8b-instant

# -----------------------------------------------------------------------
# Day 6 — Hallucination & Citation Grader + Adaptive Quiz Agent
# -----------------------------------------------------------------------

# Dedicated Groq API key for the Hallucination & Citation Grader.
# Falls back to RAG_API_KEY if unset.
GRADER_API_KEY=

# Model used by the Hallucination & Citation Grader.
# Lightweight model is sufficient (evaluation only, not generation).
GRADER_MODEL=llama-3.1-8b-instant

# Dedicated Groq API key for the Adaptive Quiz & Diagnostic Agent.
# Falls back to RAG_API_KEY if unset.
QUIZ_API_KEY=

# Model used by the Quiz Agent for MCQ generation.
QUIZ_MODEL=llama-3.1-8b-instant
