# -----------------------------------------------------------------------
# .env.example
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# -----------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_learning_db

# Directory where uploaded PDFs are saved (relative to project root or absolute)
UPLOAD_DIR=data/uploads

# Maximum allowed PDF upload size in megabytes
MAX_FILE_SIZE_MB=20
