# =======================================================================
# .env.example — Personal AI Learning Assistant Configuration Template
# =======================================================================
#
# FIRST-TIME DEVELOPER SETUP GUIDE:
# 1. Copy this template to create your private local environment file:
#      PowerShell (Windows):  Copy-Item .env.example .env
#      Bash (Linux/macOS):   cp .env.example .env
#
# 2. Add your Groq API key to RAG_API_KEY (obtain a free key at https://console.groq.com).
#    All four bounded agents (Router, CRAG, Grader, Quiz) will automatically
#    use RAG_API_KEY as a fallback if their dedicated keys are left blank.
#
# 3. SECURITY NOTICE:
#    The real '.env' file is strictly excluded from Git tracking via .gitignore.
#    NEVER commit real API keys, passwords, or production secrets to version control.
# =======================================================================

# -----------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# -----------------------------------------------------------------------
# Connection URI for tracking users, uploaded documents, chat history, and quizzes.
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DBNAME>
#
# LOCAL DEVELOPMENT & FALLBACK:
# - If Docker or PostgreSQL is running: connects to ai_learning_db.
# - If PostgreSQL is absent or connection fails: FastAPI automatically falls back
#   to a local embedded SQLite database at data/ai_learning_local.db without crashing.
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ai_learning_db

# -----------------------------------------------------------------------
# 2. LOCAL FILE STORAGE & LIMITS
# -----------------------------------------------------------------------
# Directory where uploaded lecture notes and PDF documents are stored locally.
UPLOAD_DIR=data/uploads

# Directory where preprocessed chunk JSON files are stored.
PROCESSED_DIR=data/processed

# Maximum allowed PDF upload size in megabytes.
# Enforced by both FastAPI backend and Next.js frontend dropzone validation.
MAX_FILE_SIZE_MB=20

# -----------------------------------------------------------------------
# 3. QDRANT VECTOR DATABASE CONFIGURATION
# -----------------------------------------------------------------------
# Endpoint for Qdrant vector database (used for 384-dimensional dense semantic search).
# Default Docker container port is 6333.
#
# LOCAL DEVELOPMENT & FALLBACK:
# - If Docker is running: connects to Qdrant at http://localhost:6333.
# - If Docker is not running: the system automatically falls back to local embedded
#   disk vector storage at data/qdrant_local/ (no Docker or external setup required).
QDRANT_URL=http://localhost:6333

# Optional: API key for a secured cloud/remote Qdrant cluster (e.g., Qdrant Cloud).
# Leave blank for local development or local Docker.
QDRANT_API_KEY=

# Collection name for storing document chunk vector points.
QDRANT_COLLECTION_NAME=learning_assistant

# Batch size for point vector upserts during document ingestion.
QDRANT_BATCH_SIZE=64

# -----------------------------------------------------------------------
# 4. CORE RAG PIPELINE & LLM GENERATION
# -----------------------------------------------------------------------
# Primary Groq API key for grounded RAG answer generation.
# REQUIRED: Get your free API key at https://console.groq.com/keys
# This key is server-side only and is NEVER exposed to the frontend or browser.
RAG_API_KEY=your_rag_api_key_here

# Groq LLM model used for grounded answer generation over retrieved student material.
# Default: openai/gpt-oss-120b
RAG_MODEL=openai/gpt-oss-120b

# Cross-Encoder Reranker Settings (FlashRank ms-marco-TinyBERT-L-2-v2 runs locally and offline):
# Relevance score threshold (0.0 to 1.0). Evidence below this threshold triggers
# the safe refusal: "I couldn't find sufficient information in your uploaded documents..."
RERANK_THRESHOLD=0.35

# Maximum number of unique parent context chunks sent to the LLM for grounded answer generation.
RERANK_TOP_K=4

# -----------------------------------------------------------------------
# 5. BOUNDED AGENT 1: QUERY ROUTER & REWRITER
# -----------------------------------------------------------------------
# Dedicated Groq API key for the Query Router & Rewriter Agent.
# OPTIONAL: Leave blank to automatically fall back to RAG_API_KEY.
ROUTER_API_KEY=

# Model used for classifying intent (direct_chat | rag_query | quiz_mode) and query rewriting.
ROUTER_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------
# 6. BOUNDED AGENT 2: CRAG (CORRECTIVE RAG) AGENT
# -----------------------------------------------------------------------
# Dedicated Groq API key for the Corrective RAG (CRAG) Agent.
# OPTIONAL: Leave blank to automatically fall back to RAG_API_KEY.
CRAG_API_KEY=

# Model used for generating a single alternative search query when initial retrieval is weak.
CRAG_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------
# 7. BOUNDED AGENT 3: HALLUCINATION & CITATION GRADER
# -----------------------------------------------------------------------
# Dedicated Groq API key for the Hallucination & Citation Grader.
# OPTIONAL: Leave blank to automatically fall back to RAG_API_KEY.
GRADER_API_KEY=

# Model used for verifying grounding and citations against retrieved evidence before streaming.
GRADER_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------
# 8. BOUNDED AGENT 4: ADAPTIVE QUIZ & DIAGNOSTIC AGENT
# -----------------------------------------------------------------------
# Dedicated Groq API key for Adaptive MCQ Quiz Generation.
# OPTIONAL: Leave blank to automatically fall back to RAG_API_KEY.
QUIZ_API_KEY=

# Model used for generating grounded multiple-choice questions from student notes.
QUIZ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------
# 9. GOOGLE IDENTITY SERVICES (GIS) AUTHENTICATION
# -----------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID for Google Identity Services ("Continue with Google").
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Ensure 'http://localhost:3000' is listed under Authorized JavaScript Origins.
# For local guest/dev login, a placeholder allows the app to run in Guest mode.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# -----------------------------------------------------------------------
# 10. NEXT.JS FRONTEND ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------
# URL of the running FastAPI backend server.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client-side Google OAuth Web Client ID for the Google Identity Services button.
# Must match GOOGLE_CLIENT_ID above.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# -----------------------------------------------------------------------
# 11. CORS & FRONTEND ORIGIN CONFIGURATION
# -----------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# For local development: http://localhost:3000,http://127.0.0.1:3000
# In production on Render: set to your Vercel deployment URL (e.g. https://your-app.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------
# 12. SUPABASE STORAGE (PERSISTENT PDF STORAGE FOR RENDER FREE)
# -----------------------------------------------------------------------
# Used for persistent storage of uploaded PDFs across container restarts.
# The bucket 'learnvault-documents' must be PRIVATE.
# SUPABASE_SECRET_KEY is strictly backend-only and NEVER exposed to frontend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_BUCKET_NAME=learnvault-documents

